# ── LLM (필수) ─────────────────────────────
# OpenAI 호환 LLM API 키
OPENAI_API_KEY=
# 선택: 호환 엔드포인트 (예: Z.ai GLM → https://api.z.ai/api/paas/v4)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── 채널 봇 (선택) ─────────────────────────
# 텔레그램: @BotFather → /newbot 으로 발급
TELEGRAM_BOT_TOKEN=
# 디스코드: discord.com/developers → Bot 토큰 (Message Content Intent 켜기)
DISCORD_BOT_TOKEN=

# ── 온체인 (선택) ──────────────────────────
# 설정 시 onchainBalance 기본 주소로 사용 (Phase 2에서 실서명에 사용)
EVM_PRIVATEKEY=
# Hyperliquid 시세 네트워크: mainnet(기본) | testnet
HL_NETWORK=mainnet

# ── 플랫폼 API (선택) ──────────────────────
# 설정 시 /api/v1/* 에 Bearer 인증 요구
AGENT_API_KEY=
# LLM 게이트웨이 키 목록 (쉼표 구분). 미설정 시 게이트웨이 401
GATEWAY_API_KEYS=
# x402 수취 주소. 미설정 시 /api/x402 데모 모드(무료)
X402_PAY_TO=
WEBHOOK_URL=
SWAP_FEE_RATE=0.005
GATEWAY_PRICE_PROMPT_1K=0.001
GATEWAY_PRICE_COMPLETION_1K=0.004
GATEWAY_DEMO_TOPUP=5
